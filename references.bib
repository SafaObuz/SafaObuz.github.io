@misc{mcallisterRethinkingScoreDistillation2024,
  title = {Rethinking {{Score Distillation}} as a {{Bridge Between Image Distributions}}},
  author = {McAllister, David and Ge, Songwei and Huang, Jia-Bin and Jacobs, David W. and Efros, Alexei A. and Holynski, Aleksander and Kanazawa, Angjoo},
  year = 2024,

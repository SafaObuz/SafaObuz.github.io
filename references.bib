@misc{suLinearNPointSolver2025,
  title = {A {{Linear N-Point Solver}} for {{Structure}} and {{Motion}} from {{Asynchronous Tracks}}},
  author = {Su, Hang and Feng, Yunlong and Gehrig, Daniel and Jiang, Panfeng and Gao, Ling and Lagorce, Xavier and Kneip, Laurent},
  year = 2025,

@misc{xuStableSim2RealExploringSimulation2025,
  title = {Stable-{{Sim2Real}}: {{Exploring Simulation}} of {{Real-Captured 3D Data}} with {{Two-Stage Depth Diffusion}}},
  shorttitle = {Stable-{{Sim2Real}}},
  author = {Xu, Mutian and Ye, Chongjie and Liu, Haolin and Wu, Yushuang and Chang, Jiahao and Han, Xiaoguang},
  year = 2025,
  month = jul,
  number = {arXiv:2507.23483},

@article{Herrera-Granda-MonocularVisualSLAM-2024,
  title = {Monocular Visual {{SLAM}}, Visual Odometry, and Structure from Motion Methods Applied to {{3D}} Reconstruction: {{A}} Comprehensive Survey},
  shorttitle = {Monocular Visual {{SLAM}}, Visual Odometry, and Structure from Motion Methods Applied to {{3D}} Reconstruction},
  author = {{Herrera-Granda}, Erick P. and {Torres-Cantero}, Juan C. and {Peluffo-Ord{\'o}{\~n}ez}, Diego H.},

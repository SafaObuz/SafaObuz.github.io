@misc{romerDemonstrationsSafeDeployment2025,
  title = {From {{Demonstrations}} to {{Safe Deployment}}: {{Path-Consistent Safety Filtering}} for {{Diffusion Policies}}},
  shorttitle = {From {{Demonstrations}} to {{Safe Deployment}}},
  author = {R{\"o}mer, Ralf and Balletshofer, Julian and Thumm, Jakob and Pavone, Marco and Schoellig, Angela P. and Althoff, Matthias},
  year = 2025,
  month = nov,

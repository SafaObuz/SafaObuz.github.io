@misc{Goyal-VLA0BuildingStateoftheArt-2025,
  title = {{{VLA-0}}: {{Building State-of-the-Art VLAs}} with {{Zero Modification}}},
  shorttitle = {{{VLA-0}}},
  author = {Goyal, Ankit and Hadfield, Hugo and Yang, Xuning and Blukis, Valts and Ramos, Fabio},
